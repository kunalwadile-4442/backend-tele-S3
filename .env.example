APP_NAME=TeleCloud Vault
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/telecloud_vault
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./telegram_session
TELEGRAM_STORAGE_CHANNEL_ID=
MAX_UPLOAD_SIZE_MB=50
UPLOAD_TIMEOUT_SECONDS=300
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
